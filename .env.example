# Copy to .env and fill in. NEVER commit .env.
SERPAPI_API_KEY=
GEMINI_API_KEY=
# Model name can change over time; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Set to 1 to run fully offline with canned data (tests / UI work, no credits used)
MOCK_MODE=0
# Optional: comma-separated models tried in order if the primary is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-latest
