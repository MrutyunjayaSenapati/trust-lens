# Copy to .env and fill in. NEVER commit .env.
SERPAPI_API_KEY=
GEMINI_API_KEY=
# Model name can change over time; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Set to 1 to run fully offline with canned data (tests / UI work, no credits used)
MOCK_MODE=0
# Optional, local only: use Gemini through Vertex AI with your gcloud login instead of (before) the API key.
# Run `gcloud auth application-default login` first. In Docker, also mount the gcloud folder and set
# GOOGLE_APPLICATION_CREDENTIALS (see README).
# GEMINI_VERTEX_PROJECT=your-gcp-project-id
# GEMINI_VERTEX_LOCATION=global
# Optional: comma-separated models tried in order if the primary is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-latest
