{
  "name": "TrustLens — is this real?",
  "short_name": "TrustLens",
  "description": "Check a job offer, seller or deal against live Google data. Share a suspicious WhatsApp message straight to TrustLens.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF5E9",
  "theme_color": "#1A1633",
  "lang": "en-IN",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    { "src": "/icons/192", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/512", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/512?maskable=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Accuracy benchmark", "short_name": "Accuracy", "url": "/benchmark" }
  ]
}
